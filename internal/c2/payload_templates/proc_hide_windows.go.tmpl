//go:build windows

package main

import (
	"os/exec"
	"syscall"
)

// prepareHiddenCmd prevents child processes from opening a console window (cmd / powershell / temporary exe, etc.).
func prepareHiddenCmd(cmd *exec.Cmd) {
	if cmd == nil {
		return
	}
	// Use HideWindow only: equivalent to CREATE_NO_WINDOW, and avoids the issue
	// that syscall.CREATE_NO_WINDOW is unavailable when cross-compiling for Windows on macOS/Linux.
	cmd.SysProcAttr = &syscall.SysProcAttr{HideWindow: true}
}
